DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
PGADMIN_PASSWORD=postgres
DATABASE_NAME=postgres
NAMESPACE=NAMESPACE
EMAIL_USER=EMAIL_USER
EMAIL_PASSWORD=EMAIL_PASSWORD
EMAIL_GROUPS={"engineering": "email1@foo.com", "marketing": "email2@foo.com"}
PROMETHEUS_PUSH_GATEWAY=localhost:9091
WAREHOUSE_PATH=metrics
MINIO_ENDPOINT=MINIO_ENDPOINT
MINIO_ENDPOINT_PORT=443
MINIO_ACCESS_KEY=MINIO_ACCESS_KEY
MINIO_SECRET_KEY=MINIO_SECRET_KEY
MINIO_BUCKET=MINIO_BUCKET

RUN_DAILY_REPORTS=true
LOGLEVEL=DEBUG

# Explicit local replica endpoint. Credentials/name inherit DATABASE_* unless overridden.
DATABASE_RO_HOST=localhost
DATABASE_RO_PORT=15433
REPLICA_RETRY_ATTEMPTS=3
REPLICA_RETRY_DELAY=1
REPORT_STATEMENT_TIMEOUT_MS=5000
REPORT_LOCK_TIMEOUT_MS=1000
